# Example environment configuration
# Copy this file to .env and customize as needed

# Ollama Configuration
# Set to the URL where Ollama is running (default is localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# FastAPI Configuration
# Host to bind to (keep 127.0.0.1 so the server is not exposed on the LAN)
FASTAPI_HOST=127.0.0.1

# Port to run the FastAPI server on
FASTAPI_PORT=8000

# Security
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Comma-separated Ollama model names the API will accept
ALLOWED_MODELS=qwen3:8b
# Per-client rate limit for /api/chat (slowapi format)
RATE_LIMIT=20/hour
# Max messages per chat request
MAX_MESSAGES=20
# Max characters per message
MAX_CONTENT_CHARS=10000
# Max tokens the model may generate per reply
MAX_OUTPUT_TOKENS=2048
